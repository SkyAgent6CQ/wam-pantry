# Copy to infra/.env and edit. infra/.env is git-ignored — never commit secrets.

# Your GitHub repository (HTTPS URL)
REPO_URL=https://github.com/YOUR-USERNAME/wam-pantry.git
# Only needed if the repo is private (or to push release tags): a fine-grained PAT
GITHUB_USER=
GITHUB_TOKEN=

# Jenkins login (user: admin)
JENKINS_ADMIN_PASSWORD=change-me-jenkins

# SonarQube admin password (12+ chars, upper, lower, digit, symbol)
SONAR_ADMIN_PASSWORD=Sonar-Admin-2026!
# Filled in automatically by bootstrap.sh
SONAR_TOKEN=

# Application secrets injected into staging/production by Jenkins credentials
APP_JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
APP_ADMIN_PASSWORD=WamAdmin-2026!

# Monitoring
GRAFANA_ADMIN_PASSWORD=admin
# Optional Slack/Discord/Teams incoming webhook for alert notifications
ALERT_WEBHOOK_URL=
