{
  "name": "wam-pantry",
  "version": "1.0.0",
  "description": "Food relief pantry API for With A Mission: inventory, pickup bookings, low-stock alerts and Prometheus metrics.",
  "main": "src/server.js",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "lint:report": "eslint . -f json -o reports/eslint.json || true",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:ci": "jest --ci --coverage",
    "test:smoke": "jest -c jest.smoke.config.js --ci",
    "security:summary": "node scripts/security-summary.js",
    "sonar": "sonar-scanner-npm"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sonar/scan": "^5.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "supertest": "^7.3.1"
  },
  "files": [
    "src"
  ]
}
